<Window x:Class="ClinicaVeterinariaWPF.DoctorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:ClinicaVeterinariaWPF"
        mc:Ignorable="d"
        Title="DoctorWindow" Height="850" Width="800"
        Background="#F6FFFE">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10" Background="#EDFFFE">
            <StackPanel>
                <TextBlock Text="Pesquisa de doutores" VerticalAlignment="Center" Margin="0,0,5,20" FontSize="20" FontWeight="Bold" Foreground="#2D6A6A"/>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Procurar por:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="DemiBold"/>
                    <ComboBox x:Name="ComboBoxSearch" Width="160" Margin="0,0,10,0">
                        <ComboBoxItem Content="Nome"/>
                        <ComboBoxItem Content="Especialidade"/>
                    </ComboBox>
                    <TextBox x:Name="TextBoxSearch" Width="387" Margin="0,0,10,0"/>
                    <Button x:Name="btnSearch" Content="Procurar" Style="{StaticResource PrimaryButton}" Width="100" Click="btnSearch_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10" Background="#EDFFFE">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                    <TextBlock Text="Lista de doutores" VerticalAlignment="Center" Margin="0,0,239,0" FontSize="20" FontWeight="Bold" Foreground="#2D6A6A"/>
                    <Button x:Name="btnAllList" Content="Lista Completa" Style="{StaticResource PrimaryButton}" Width="120" Margin="0,0,10,0" Click="btnAllList_Click"/>
                    <Button x:Name="btnEdit" Content="Editar" Style="{StaticResource EditButton}" Width="100" Margin="0,0,10,0" Click="btnEdit_Click"/>
                    <Button x:Name="btnDelete" Content="Eliminar" Style="{StaticResource DangerButton}" Width="100" Click="btnDelete_Click"/>
                </StackPanel>

                <DataGrid x:Name="DataGridSearch" Grid.Row="1" Margin="0,0,0,10" AutoGenerateColumns="False" IsReadOnly="True" FontWeight="DemiBold">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="Especialidade" Binding="{Binding Speciality}" Width="*"/>
                        <DataGridTextColumn Header="Ativo" Binding="{Binding Active}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10" Background="#EDFFFE">
            <StackPanel>
                <TextBlock Text="Dados do cliente" VerticalAlignment="Center" Margin="0,0,5,14" FontSize="20" FontWeight="Bold" Foreground="#2D6A6A"/>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="500"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,8,20,0">
                        <TextBlock Text="Nome" FontWeight="DemiBold"/>
                        <TextBox x:Name="TextBoxName" Margin="0,2,0,5"/>
                        <TextBlock Text="Telefone" FontWeight="DemiBold"/>
                        <TextBox x:Name="TextBoxPhoneNumber" Margin="0,2,0,5"/>
                        <TextBlock Text="Especialidade" FontWeight="DemiBold"/>
                        <TextBox x:Name="TextBoxSpeciality" Margin="0,2,0,5"/>
                        <CheckBox x:Name="CheckBoxActive" Content="Ativo" Margin="0,5,0,0" FontWeight="DemiBold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="20,0,0,0">
                        <TextBlock Text="Horário Semanal" FontWeight="Bold" Margin="0,0,0,5" FontSize="15"/>

                        <DataGrid x:Name="DataGridSchedule" AutoGenerateColumns="False" IsReadOnly="True" Height="180" Margin="0,0,0,10" FontWeight="DemiBold">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Dia" Binding="{Binding DayOfWeek}" Width="1.5*"/>
                                <DataGridTextColumn Header="Início" Binding="{Binding StartDisplay}" Width="*"/>
                                <DataGridTextColumn Header="Fim" Binding="{Binding EndDisplay}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnAddHour" Content="Adicionar Horas" Style="{StaticResource PrimaryButton}" Width="120" Margin="0,0,5,0" Click="btnAddHour_Click"/>
                            <Button x:Name="btnDayOff" Content="Folga" Style="{StaticResource PrimaryButton}" Width="120" Click="btnDayOff_Click"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Hora Início" FontWeight="DemiBold"/>
                                <xctk:TimePicker x:Name="TimePickerStart" Width="100" Format="ShortTime"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Hora Fim" FontWeight="DemiBold" Margin="16,0,0,0"/>
                                <xctk:TimePicker x:Name="TimePickerEnd" Width="100" Format="ShortTime" Margin="16,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button x:Name="btnNew" Content="Novo" Style="{StaticResource PrimaryButton}" Width="100" Margin="0,0,10,0" Click="btnNew_Click"/>
                    <Button x:Name="btnSave" Content="Guardar" Style="{StaticResource PrimaryButton}" Width="100" Margin="0,0,10,0"  Click="btnSave_Click"/>
                    <Button x:Name="btnClose" Content="Fechar" Style="{StaticResource SecondaryButton}" Width="100" Click="btnClose_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
       
    </Grid>
</Window>
