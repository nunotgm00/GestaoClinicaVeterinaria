<Window x:Class="ClinicaVeterinariaWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClinicaVeterinariaWPF"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        mc:Ignorable="d"
        Title="MainWindow"
        WindowState="Maximized">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0" Margin="0,20,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="220"/>
                        <RowDefinition Height="45"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="/Images/logoPacheco.png"/>
                        </StackPanel>
                    </Border>

                    <Path Grid.Row="1" Fill="#2D6A6A" Stretch="Fill" Data="M0,20 C70,55 170,0 250,25 L250,60 L0,60 Z"/>

                    <Grid Grid.Row="2" Background="#2D6A6A">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <Button Grid.Row="0" x:Name="btnHome" Style="{StaticResource SidebarButton}" Click="btnHome_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <fa:IconBlock Icon="Home" FontSize="25" Width="30"/>
                                <TextBlock Text="   Início" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="1" x:Name="btnAnimals" Style="{StaticResource SidebarButton}" Click="btnAnimals_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <fa:IconBlock Icon="Cat" FontSize="25" Width="30"/>
                                <TextBlock Text="   Animais" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="2" x:Name="btnClients" Style="{StaticResource SidebarButton}" Click="btnClients_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <fa:IconBlock Icon="User" FontSize="25" Width="30"/>
                                <TextBlock Text="   Clientes" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button> 
                        <Button Grid.Row="3" x:Name="btnDoctors" Style="{StaticResource SidebarButton}" Click="btnDoctors_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <fa:IconBlock Icon="UserMd" FontSize="25" Width="30"/>
                                <TextBlock Text="   Doutores" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="4" x:Name="btnRooms" Style="{StaticResource SidebarButton}" Click="btnRooms_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <fa:IconBlock Icon="ClinicMedical" FontSize="25" Width="30"/>
                                <TextBlock Text="   Salas" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="5" x:Name="btnAppointments" Style="{StaticResource SidebarButton}" Click="btnAppointments_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <fa:IconBlock Icon="ClipboardList" FontSize="25" Width="30"/>
                                <TextBlock Text="   Consultas" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
                <Grid Grid.Row="1" VerticalAlignment="Bottom" Background="{StaticResource PrimaryBrush}">
                    <Button x:Name="btnCredits" Style="{StaticResource SidebarButton}" Click="btnCredits_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <fa:IconBlock Icon="InfoCircle" FontSize="25"/>
                            <TextBlock Text="   Créditos" VerticalAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                    <Popup x:Name="popupCredits" PlacementTarget="{Binding ElementName=btnCredits}" Placement="Right" StaysOpen="false" AllowsTransparency="True">
                        <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Padding="15">
                            <StackPanel>
                                <TextBlock Text="Clínica Veterinária Pacheco" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Text="Desenvolvido por"/>
                                <TextBlock Text="Nuno Tiago Germano Melanda"/>
                                <TextBlock Margin="0,10,0,0" Text="Versão 1.0"/>
                                <TextBlock Text=".NET Framework 4.7.2"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
        </Border>

        <ContentControl x:Name="ContentArea" Grid.Column="1"/>
    </Grid>
</Window>
