<Window x:Class="ClinicaVeterinariaWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClinicaVeterinariaWPF"
        mc:Ignorable="d"
        Title="MainWindow"
        WindowState="Maximized">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PrimaryBrush}">
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="Clínica Veterinária Pacheco" Foreground="white" FontSize="18" FontWeight="Bold" Margin="16,0,16,20" TextWrapping="Wrap"/>

                <Button x:Name="btnClients" Content="Clientes" Style="{StaticResource SidebarButton}" Click="btnClients_Click"/>
                <Button x:Name="btnAnimals" Content="Animais" Style="{StaticResource SidebarButton}" Click="btnAnimals_Click"/>
                <Button x:Name="btnDoctors" Content="Doutores" Style="{StaticResource SidebarButton}" Click="btnDoctors_Click"/>
                <Button x:Name="btnRooms" Content="Salas" Style="{StaticResource SidebarButton}" Click="btnRooms_Click"/>
                <Button x:Name="btnAppointments" Content="Consultas" Style="{StaticResource SidebarButton}" Click="btnAppointments_Click"/>
                <Button x:Name="btnCredits" Content="Créditos" Style="{StaticResource SidebarButton}" Click="btnCredits_Click"/>
            </StackPanel>
        </Border>

        <ContentControl x:Name="ContentArea" Grid.Column="1"/>
    </Grid>
</Window>
