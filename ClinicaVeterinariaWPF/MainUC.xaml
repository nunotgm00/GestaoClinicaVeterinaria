<UserControl x:Class="ClinicaVeterinariaWPF.MainUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ClinicaVeterinariaWPF"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="50,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" HorizontalAlignment="Left">
                <TextBlock Text="Bem-Vindo" FontSize="30" FontWeight="DemiBold" Foreground="Black"/>
            </Grid>
            <Grid Grid.Row="1" HorizontalAlignment="Left">
                <TextBlock Text="Clínica Veterinária Pacheco" FontSize="50" FontWeight="DemiBold" Foreground="#2D6A6A"/>
            </Grid>
            
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" ClipToBounds="True">
                <Ellipse Width="300" Height="300" Fill="#2D6A6A" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="150,0,0,40"/>
                <Ellipse Width="300" Height="300" Fill="#2D6A6A" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="210,0,0,-110"/>
                <Ellipse Width="300" Height="300" Fill="#2D6A6A" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,100"/>
                <Ellipse Width="400" Height="400" Fill="#2D6A6A" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-160,0,0,60"/>
                <Ellipse Width="550" Height="550" Fill="#70AEB0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-220,0,0,-220"/>
                <Ellipse Width="300" Height="300" Fill="#70AEB0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="200,0,0,-140"/>
                <Ellipse Width="300" Height="300" Fill="#70AEB0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-150,0,0,100"/>
            </Grid>
            <Grid Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                <Image Source="/Images/dogCat.png" Width="650" Height="650"/>
            </Grid>
            
        </Grid>
    </Grid>
</UserControl>
